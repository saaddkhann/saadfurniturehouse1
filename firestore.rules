rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Customer checkout can create an order without signing in.
      // Never allow public clients to read, edit, or delete orders.
      allow create: if request.resource.data.keys().hasAll([
        'customer', 'items', 'total', 'paymentMethod', 'deliveryMethod', 'status', 'paymentStatus'
      ])
      && request.resource.data.customer is map
      && request.resource.data.customer.keys().hasAll(['name', 'phone', 'address'])
      && request.resource.data.items is list
      && request.resource.data.items.size() > 0
      && request.resource.data.items.size() <= 30
      && request.resource.data.total is number
      && request.resource.data.total >= 0
      && request.resource.data.paymentMethod in ['cod', 'upi']
      && request.resource.data.deliveryMethod in ['delivery', 'pickup']
      && request.resource.data.status == 'Pending';
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Admin membership documents must be created manually in the Firebase Console.
      allow write: if false;
    }
  }
}