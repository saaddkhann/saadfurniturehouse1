# Firebase project settings: Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary (optional but recommended for product image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# UPI payment: replace with your shop's verified UPI ID and display name
VITE_UPI_ID=yourshop@upi
VITE_UPI_NAME=Saad Furniture House

# WhatsApp number with country code, digits only, e.g. 919876543210
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX
